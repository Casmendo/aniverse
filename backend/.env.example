# ── AniVerse Backend Environment ──────────────────────
# Copy to .env and fill in your values

SECRET_KEY=your-super-secret-flask-key-change-this-in-production
API_BASE=https://apis.ayohost.site
DOWNLOAD_BASE_PATH=/root/Downloads/ayonime

# Frontend URL for CORS (update in production)
FRONTEND_URL=http://localhost:3000

# Database (defaults to SQLite for dev)
# DATABASE_URL=postgresql://user:password@localhost/aniverse

# Flask environment
# FLASK_ENV=production

# Optional: Email config for real OTP sending
# MAIL_SERVER=smtp.gmail.com
# MAIL_PORT=587
# MAIL_USE_TLS=true
# MAIL_USERNAME=your@gmail.com
# MAIL_PASSWORD=your-app-password
# MAIL_DEFAULT_SENDER=noreply@aniverse.app
